{
  "name": "@ministryofjustice/hmpps-probation-frontend-components",
  "version": "1.3.0",
  "description": "A package to allow the inclusion of connect pds micro frontend components within pds applications",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "prepare": "hmpps-precommit-hooks-prepare",
    "build": "tsc && npm run copy:assets",
    "clean": "find . -name '.eslintcache' -delete",
    "test": "jest",
    "test:ci": "jest --runInBand --passWithNoTests",
    "typecheck": "tsc",
    "lint": "eslint . --cache --max-warnings 0",
    "lint:fix": "eslint . --cache --max-warnings 0 --fix",
    "copy:assets": "rm -rf dist/assets && cp -r src/assets dist/assets",
    "security_audit": "npx audit-ci --config audit-ci.json"
  },
  "lint-staged": {
    "*.{ts,css}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.json": [
      "prettier --write"
    ]
  },
  "jest": {
    "transform": {
      "^.+\\.[tj]sx?$": "ts-jest"
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!sanitize-html/|htmlparser2/|domhandler/|domutils/|domelementtype/|dom-serializer/|entities/|@ministryofjustice/hmpps-rest-client/|agentkeepalive/)"
    ],
    "testMatch": [
      "<rootDir>/**/**/?(*.)(cy|test).{ts,js,jsx,mjs}"
    ],
    "testEnvironment": "node",
    "reporters": [
      "default",
      [
        "jest-junit",
        {
          "outputDirectory": "test_results/jest/"
        }
      ],
      [
        "./node_modules/jest-html-reporter",
        {
          "outputPath": "test_results/unit-test-reports.html"
        }
      ]
    ],
    "moduleFileExtensions": [
      "web.js",
      "js",
      "json",
      "node",
      "ts"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com:ministryofjustice/hmpps-probation-frontend-components.git"
  },
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ministryofjustice/hmpps-probation-frontend-components/issues"
  },
  "homepage": "https://github.com/ministryofjustice/hmpps-probation-frontend-components#readme",
  "devDependencies": {
    "@ministryofjustice/eslint-config-hmpps": "^1.0.4",
    "@ministryofjustice/hmpps-precommit-hooks": "^3.0.0",
    "@types/bunyan": "^1.8.11",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "26.6.5",
    "@types/sanitize-html": "^2.16.1",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "cheerio": "^1.0.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-no-only-tests": "^3.3.0",
    "express": "^5.2.1",
    "govuk-frontend": "^6.1.0",
    "jest": "^30.5.2",
    "jest-html-reporter": "^4.4.3",
    "jest-junit": "^17.0.0",
    "lint-staged": "^17.0.4",
    "nock": "^14.0.12",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.15",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@ministryofjustice/hmpps-probation-frontend-components": "^1.1.1",
    "@ministryofjustice/hmpps-rest-client": "2.2.0",
    "@types/nunjucks": "^3.2.6",
    "nunjucks": "^3.2.4",
    "sanitize-html": "2.18.2"
  },
  "overrides": {
    "@babel/core": "^7.29.0",
    "body-parser": "^2.2.2",
    "brace-expansion": "^5.0.7",
    "braces": "^3.0.3",
    "decode-uri-component": "^0.5.1",
    "deepmerge": "4.1.2",
    "form-data": "^4.0.4",
    "glob": "^14.0.2",
    "js-yaml": "^4.2.0",
    "micromatch": "^4.0.8",
    "minimatch@7": "11.0.8",
    "minimatch@8": "11.0.8",
    "minimatch@9": "11.0.8",
    "minimatch@10": "11.0.8",
    "minimatch@11.0.0": "11.0.8",
    "qs": "^6.14.1",
    "tough-cookie": "^4.1.4",
    "undici": "^7.30.1",
    "uuid": "^11.1.1"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "unrs-resolver@1.12.2": true,
    "fsevents@2.3.3": true
  }
}
